# Environment Variables — SLA Pulse

# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────────
# SQLite (local dev — default, no setup required)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — uncomment and replace:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sla_pulse?schema=public"

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Monitoring Simulator ─────────────────────────────
SIMULATOR_INTERVAL_MS=30000
DATA_RETENTION_DAYS=30
